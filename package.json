{
  "name": "dsh-plugin-tav2",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：对话式游戏本地化，把 tav2（TranslateAgent v2）翻译流水线接入 dsh。引擎适配器架构，首发支持 Ren'Py。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/install-plugin.ps1",
    "scripts/postbuild.mjs",
    "scripts/build-client.mjs",
    "scripts/renpy_pack_rpa.py",
    "python/README.md",
    "python/requirements.txt",
    "python/tav2",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ab": "tsx scripts/ab-run.ts",
    "ab-structure": "tsx scripts/ab-structure.ts",
    "prepack": "node scripts/clean-python-cache.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "translation",
    "localization",
    "game-localization",
    "renpy",
    "visual-novel"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
